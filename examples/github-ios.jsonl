# An open-source repo on GitHub, filmed as an iPhone on the brand-green wallpaper:
# astral-sh/uv -> Pull requests -> the newest PR -> its discussion and checks.
# (A tap on GitHub's multi-line list links does not navigate; Enter after it does.)
{"op":"frame","platform":"ios"}
{"op":"navigate","url":"https://github.com/astral-sh/uv","timeout_ms":60000}
{"op":"wait","selector":"a[data-testid=\"repo-name-link\"]","timeout_ms":30000}
{"op":"wait","ms":800}
{"op":"start_recording"}
{"op":"wait","ms":1200}
{"op":"scroll","y":360,"smooth":true}
{"op":"wait","ms":1000}
{"op":"scroll","y":0,"smooth":true}
{"op":"wait","ms":500}
{"op":"click","selector":"a[href=\"/astral-sh/uv/pulls\"]"}
{"op":"press","key":"Enter"}
{"op":"wait","selector":"a[href*=\"/astral-sh/uv/pull/\"]","timeout_ms":30000}
{"op":"wait","ms":1100}
{"op":"click","selector":"a[href*=\"/astral-sh/uv/pull/\"]"}
{"op":"press","key":"Enter"}
{"op":"wait","selector":"h1","timeout_ms":30000}
{"op":"wait","ms":1500}
{"op":"scroll","y":900,"smooth":true}
{"op":"wait","ms":1300}
{"op":"scroll","y":2000,"smooth":true}
{"op":"wait","ms":2000}
{"op":"stop_recording"}
